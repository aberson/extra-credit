{
  "name": "extra-credit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "npm run dev:preflight && concurrently --kill-others --success first \"npm:dev:web\" \"npm:dev:server\"",
    "dev:preflight": "tsx scripts/dev-preflight.ts",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/dev.ts",
    "build": "rimraf dist && npm run typecheck && vite build && tsc -p tsconfig.server.build.json",
    "start": "node dist/server/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.shared.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/server-harness.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "security": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "write-file-atomic": "7.0.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "fast-check": "^4.3.0",
    "globals": "^17.0.0",
    "jsdom": "^28.0.0",
    "pdf-lib": "^1.17.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "yaml": "^2.8.1"
  }
}
