{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "src/worksheets/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
